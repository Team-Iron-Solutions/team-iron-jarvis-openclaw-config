<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>JARVIS — Team Iron Solutions</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
body{background:#000;width:100vw;height:100vh;overflow:hidden;font-family:'Rajdhani',sans-serif;color:#00d4ff;display:flex;align-items:center;justify-content:center}
#bg{position:fixed;inset:0;z-index:0}
.grid{position:fixed;inset:0;background-image:linear-gradient(rgba(0,212,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.025) 1px,transparent 1px);background-size:60px 60px;z-index:1;animation:gp 6s ease-in-out infinite}
@keyframes gp{0%,100%{opacity:.4}50%{opacity:1}}
.scanline{position:fixed;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(0,212,255,.3),transparent);z-index:2;animation:sc 10s linear infinite;pointer-events:none}
@keyframes sc{0%{top:-2px}100%{top:100vh}}
.hud{position:relative;z-index:10;width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;padding:0 clamp(140px,15vw,200px)}
.stage{position:relative;width:min(60vh,60vw);height:min(60vh,60vw);display:flex;align-items:center;justify-content:center}
.geo-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.avatar-clip{width:min(36vh,36vw);height:min(36vh,36vw);clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);overflow:hidden;position:relative;z-index:5;filter:drop-shadow(0 0 32px rgba(0,212,255,.7));animation:ap 3s ease-in-out infinite;cursor:pointer}
@keyframes ap{0%,100%{filter:drop-shadow(0 0 20px rgba(0,212,255,.5)) brightness(1)}50%{filter:drop-shadow(0 0 44px rgba(0,212,255,.9)) brightness(1.08)}}
.avatar-clip img{width:100%;height:100%;object-fit:cover}
.arc{position:absolute;bottom:min(5vh,5vw);left:50%;transform:translateX(-50%);width:min(4.5vh,4.5vw);height:min(4.5vh,4.5vw);border-radius:50%;background:radial-gradient(circle,#fff 5%,#00d4ff 30%,#004488 70%,#000 100%);box-shadow:0 0 16px #00d4ff,0 0 40px rgba(0,212,255,.6);animation:ar 1.8s ease-in-out infinite;z-index:6}
@keyframes ar{0%,100%{box-shadow:0 0 16px #00d4ff,0 0 40px rgba(0,212,255,.5)}50%{box-shadow:0 0 32px #00d4ff,0 0 90px rgba(0,212,255,.8),0 0 140px rgba(0,212,255,.3)}}
.status-row{position:absolute;bottom:min(-9vh,-44px);left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:10px;white-space:nowrap}
.sdot{width:8px;height:8px;border-radius:50%;background:#00ff88;box-shadow:0 0 8px #00ff88;animation:bl 1.5s ease-in-out infinite}
@keyframes bl{0%,100%{opacity:1}50%{opacity:.2}}
.stxt{font-family:'Orbitron',monospace;font-size:11px;letter-spacing:4px;color:#00ff88;text-transform:uppercase}
.title-wrap{position:absolute;top:min(-10vh,-48px);left:50%;transform:translateX(-50%);text-align:center;white-space:nowrap}
.title-wrap h1{font-family:'Orbitron',monospace;font-size:clamp(20px,4vw,42px);font-weight:900;letter-spacing:8px;background:linear-gradient(135deg,#ffaa00,#fff,#ffaa00);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.title-wrap .sub{font-size:10px;letter-spacing:6px;color:rgba(0,212,255,.4);text-transform:uppercase;margin-top:4px}
.panel{position:absolute;top:50%;display:flex;flex-direction:column;gap:8px;width:clamp(130px,14vw,185px)}
.panel.left{left:0;transform:translate(calc(-100% - 16px),-50%)}
.panel.right{right:0;transform:translate(calc(100% + 16px),-50%)}
.dblock{border:1px solid rgba(0,212,255,.18);background:rgba(0,8,25,.88);padding:10px 12px;border-radius:6px;position:relative;overflow:hidden}
.dblock::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(0,212,255,.4),transparent)}
.panel.left .dblock{border-left:2px solid rgba(0,212,255,.55)}
.panel.right .dblock{border-right:2px solid rgba(0,212,255,.55);text-align:right}
.dlabel{font-size:9px;letter-spacing:3px;color:rgba(0,212,255,.4);text-transform:uppercase;margin-bottom:4px}
.dval{font-family:'Orbitron',monospace;font-size:15px;font-weight:700;color:#00d4ff}
.dval.gold{color:#ffaa00}.dval.green{color:#00ff88}
.dbar{height:3px;background:rgba(0,212,255,.08);border-radius:2px;margin-top:6px;overflow:hidden}
.dbar-fill{height:100%;background:linear-gradient(90deg,#00d4ff,#00ff88);border-radius:2px;animation:brf 3s ease-in-out infinite}
@keyframes brf{0%,100%{opacity:.7}50%{opacity:1}}
.waveform{position:absolute;bottom:min(-13vh,-70px);left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:3px;height:44px}
.wb{width:3px;border-radius:2px;background:linear-gradient(to top,#00d4ff,rgba(0,212,255,.2));animation:wv ease-in-out infinite}
@keyframes wv{0%,100%{transform:scaleY(.15)}50%{transform:scaleY(1)}}
.bot{position:fixed;bottom:0;left:0;right:0;height:44px;background:rgba(0,4,14,.95);border-top:1px solid rgba(0,212,255,.08);display:flex;align-items:center;justify-content:space-between;padding:0 24px;z-index:20;font-size:9px;letter-spacing:3px;color:rgba(0,212,255,.3);text-transform:uppercase}
.tis-logo{font-family:'Orbitron',monospace;font-size:10px;font-weight:700;letter-spacing:3px;color:rgba(255,170,0,.5)}
.ticker-wrap{overflow:hidden;flex:1;margin:0 24px}
.ticker{white-space:nowrap;animation:tk 28s linear infinite;display:inline-block}
@keyframes tk{0%{transform:translateX(60%)}100%{transform:translateX(-100%)}}
body.speaking .sdot{background:#ffaa00;box-shadow:0 0 8px #ffaa00;animation:bl .3s ease-in-out infinite}
body.speaking .stxt{color:#ffaa00}
body.speaking .wb{animation-duration:.13s!important}
body.speaking .avatar-clip{animation:ap .5s ease-in-out infinite}
@keyframes spinR{to{transform:rotate(360deg)}}
@keyframes hexPulse{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.08);opacity:1}}
@keyframes triClose{0%,100%{transform:scale(1)}45%{transform:scale(.55)}55%{transform:scale(.55)}}
@keyframes bracketTL{0%,100%{transform:translate(0,0)}50%{transform:translate(22px,22px)}}
@keyframes bracketTR{0%,100%{transform:translate(0,0)}50%{transform:translate(-22px,22px)}}
@keyframes bracketBL{0%,100%{transform:translate(0,0)}50%{transform:translate(22px,-22px)}}
@keyframes bracketBR{0%,100%{transform:translate(0,0)}50%{transform:translate(-22px,-22px)}}
@keyframes nodePulse{0%,100%{opacity:.3}50%{opacity:1}}
/* ── Chat Panel ── */
.chat-panel{position:fixed;bottom:54px;left:50%;transform:translateX(-50%);width:min(80vw,900px);z-index:15;pointer-events:none;max-height:110px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;mask-image:linear-gradient(to bottom,transparent 0%,rgba(0,0,0,.5) 30%,#000 100%);-webkit-mask-image:linear-gradient(to bottom,transparent 0%,rgba(0,0,0,.5) 30%,#000 100%)}
.chat-messages{display:flex;flex-direction:column;gap:3px;padding:4px 8px;}
.chat-msg{display:flex;align-items:center;gap:6px;animation:msgIn .4s cubic-bezier(.16,1,.3,1)}
@keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.chat-msg.user{justify-content:flex-start}
.chat-msg.assistant{justify-content:flex-end}
.chat-label{font-family:'Orbitron',monospace;font-size:7px;letter-spacing:2px;opacity:.35;white-space:nowrap;flex-shrink:0}
.chat-msg.user .chat-label{color:#00d4ff}
.chat-msg.assistant .chat-label{color:#ffaa00}
.bubble{padding:4px 10px;font-size:10.5px;letter-spacing:.3px;line-height:1.35;max-width:65%;font-family:'Rajdhani',sans-serif;border-radius:12px;word-break:break-word;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-msg.user .bubble{background:rgba(0,212,255,.06);border:1px solid rgba(0,212,255,.14);border-bottom-left-radius:3px;color:rgba(0,212,255,.8)}
.chat-msg.assistant .bubble{background:rgba(255,170,0,.06);border:1px solid rgba(255,170,0,.16);border-bottom-right-radius:3px;color:rgba(255,200,60,.85)}
/* Processing dots */
.proc-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:#ffaa00;margin:0 2px;animation:pd .9s ease-in-out infinite}
.proc-dot:nth-child(2){animation-delay:.2s}.proc-dot:nth-child(3){animation-delay:.4s}
@keyframes pd{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-5px)}}
/* Speaking glow on avatar */
body.speaking .avatar-clip{filter:drop-shadow(0 0 44px rgba(255,170,0,.85)) brightness(1.18)!important;animation:apSpk .3s ease-in-out infinite!important}
@keyframes apSpk{0%,100%{filter:drop-shadow(0 0 36px rgba(255,170,0,.7)) brightness(1.12)}50%{filter:drop-shadow(0 0 60px rgba(255,170,0,1)) brightness(1.25)}}
body.processing .sdot{background:#ff6600;box-shadow:0 0 8px #ff6600;animation:bl .5s ease-in-out infinite}
body.processing .stxt{color:#ff6600}
</style>
</head>
<body>
<canvas id="bg"></canvas>
<div class="grid"></div>
<div class="scanline"></div>
<div class="hud">
  <div class="stage">
    <svg class="geo-svg" viewBox="0 0 540 540" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Outer ring -->
      <circle cx="270" cy="270" r="258" stroke="rgba(0,212,255,0.1)" stroke-width="1"/>
      <circle cx="270" cy="270" r="258" stroke="rgba(0,212,255,0.4)" stroke-width="1.5" stroke-dasharray="90 18 45 65 18 110 14 44" style="animation:spinR 22s linear infinite;transform-origin:270px 270px"/>
      <!-- Expanding hexagons -->
      <polygon points="270,60 470,172 470,368 270,480 70,368 70,172" stroke="rgba(0,212,255,0.05)" stroke-width="1" fill="none" style="animation:hexPulse 4.5s ease-in-out infinite;transform-origin:270px 270px"/>
      <polygon points="270,82 448,184 448,356 270,458 92,356 92,184" stroke="rgba(0,212,255,0.09)" stroke-width="1" fill="none" style="animation:hexPulse 4.5s ease-in-out infinite .35s;transform-origin:270px 270px"/>
      <polygon points="270,104 426,196 426,344 270,436 114,344 114,196" stroke="rgba(0,212,255,0.13)" stroke-width="1.5" fill="none" style="animation:hexPulse 4.5s ease-in-out infinite .7s;transform-origin:270px 270px"/>
      <polygon points="270,126 404,208 404,332 270,414 136,332 136,208" stroke="rgba(255,170,0,0.09)" stroke-width="1" fill="none" style="animation:hexPulse 4.5s ease-in-out infinite 1.05s;transform-origin:270px 270px"/>
      <!-- Inner arcs -->
      <circle cx="270" cy="270" r="208" stroke="rgba(0,212,255,0.07)" stroke-width="1" fill="none"/>
      <circle cx="270" cy="270" r="208" stroke="rgba(0,212,255,0.35)" stroke-width="1.5" fill="none" stroke-dasharray="65 14 34 65" style="animation:spinR 16s linear infinite reverse;transform-origin:270px 270px"/>
      <circle cx="270" cy="270" r="186" stroke="rgba(255,170,0,0.14)" stroke-width="1" fill="none" stroke-dasharray="44 22 22 88" style="animation:spinR 10s linear infinite;transform-origin:270px 270px"/>
      <circle cx="270" cy="270" r="170" stroke="rgba(0,212,255,0.18)" stroke-width="1" fill="none" stroke-dasharray="28 12 55 12" style="animation:spinR 7s linear infinite reverse;transform-origin:270px 270px"/>
      <!-- Triangles -->
      <g style="animation:triClose 5.5s ease-in-out infinite;transform-origin:270px 270px"><line x1="270" y1="270" x2="82" y2="82" stroke="rgba(0,212,255,0.18)" stroke-width="1"/><polygon points="82,82 126,82 82,126" fill="none" stroke="rgba(0,212,255,0.55)" stroke-width="1.5"/></g>
      <g style="animation:triClose 5.5s ease-in-out infinite .9s;transform-origin:270px 270px"><line x1="270" y1="270" x2="458" y2="82" stroke="rgba(0,212,255,0.18)" stroke-width="1"/><polygon points="458,82 414,82 458,126" fill="none" stroke="rgba(0,212,255,0.55)" stroke-width="1.5"/></g>
      <g style="animation:triClose 5.5s ease-in-out infinite 1.8s;transform-origin:270px 270px"><line x1="270" y1="270" x2="458" y2="458" stroke="rgba(0,212,255,0.18)" stroke-width="1"/><polygon points="458,458 414,458 458,414" fill="none" stroke="rgba(255,170,0,0.55)" stroke-width="1.5"/></g>
      <g style="animation:triClose 5.5s ease-in-out infinite 2.7s;transform-origin:270px 270px"><line x1="270" y1="270" x2="82" y2="458" stroke="rgba(0,212,255,0.18)" stroke-width="1"/><polygon points="82,458 126,458 82,414" fill="none" stroke="rgba(255,170,0,0.55)" stroke-width="1.5"/></g>
      <!-- Bracket corners -->
      <g style="animation:bracketTL 4.5s ease-in-out infinite;transform-origin:120px 120px"><line x1="88" y1="120" x2="88" y2="88" stroke="rgba(0,212,255,0.75)" stroke-width="2"/><line x1="88" y1="88" x2="120" y2="88" stroke="rgba(0,212,255,0.75)" stroke-width="2"/></g>
      <g style="animation:bracketTR 4.5s ease-in-out infinite;transform-origin:420px 120px"><line x1="452" y1="120" x2="452" y2="88" stroke="rgba(0,212,255,0.75)" stroke-width="2"/><line x1="452" y1="88" x2="420" y2="88" stroke="rgba(0,212,255,0.75)" stroke-width="2"/></g>
      <g style="animation:bracketBL 4.5s ease-in-out infinite;transform-origin:120px 420px"><line x1="88" y1="420" x2="88" y2="452" stroke="rgba(255,170,0,0.65)" stroke-width="2"/><line x1="88" y1="452" x2="120" y2="452" stroke="rgba(255,170,0,0.65)" stroke-width="2"/></g>
      <g style="animation:bracketBR 4.5s ease-in-out infinite;transform-origin:420px 420px"><line x1="452" y1="420" x2="452" y2="452" stroke="rgba(255,170,0,0.65)" stroke-width="2"/><line x1="452" y1="452" x2="420" y2="452" stroke="rgba(255,170,0,0.65)" stroke-width="2"/></g>
      <!-- Tick marks -->
      <g style="animation:spinR 32s linear infinite;transform-origin:270px 270px">
        <line x1="270" y1="12" x2="270" y2="30" stroke="rgba(0,212,255,.55)" stroke-width="2.5"/>
        <line x1="270" y1="510" x2="270" y2="528" stroke="rgba(0,212,255,.55)" stroke-width="2.5"/>
        <line x1="12" y1="270" x2="30" y2="270" stroke="rgba(0,212,255,.55)" stroke-width="2.5"/>
        <line x1="510" y1="270" x2="528" y2="270" stroke="rgba(0,212,255,.55)" stroke-width="2.5"/>
        <line x1="70" y1="70" x2="84" y2="84" stroke="rgba(255,170,0,.45)" stroke-width="2"/>
        <line x1="456" y1="84" x2="470" y2="70" stroke="rgba(255,170,0,.45)" stroke-width="2"/>
        <line x1="70" y1="470" x2="84" y2="456" stroke="rgba(255,170,0,.45)" stroke-width="2"/>
        <line x1="456" y1="456" x2="470" y2="470" stroke="rgba(255,170,0,.45)" stroke-width="2"/>
      </g>
      <!-- Hex nodes -->
      <polygon points="270,18 281,24 281,36 270,42 259,36 259,24" fill="rgba(0,212,255,.3)" stroke="rgba(0,212,255,.65)" stroke-width="1" style="animation:nodePulse 2s ease-in-out infinite"/>
      <polygon points="270,498 281,504 281,516 270,522 259,516 259,504" fill="rgba(0,212,255,.3)" stroke="rgba(0,212,255,.65)" stroke-width="1" style="animation:nodePulse 2s ease-in-out infinite .5s"/>
      <polygon points="18,270 30,263 42,270 42,282 30,289 18,282" fill="rgba(255,170,0,.3)" stroke="rgba(255,170,0,.65)" stroke-width="1" style="animation:nodePulse 2s ease-in-out infinite 1s"/>
      <polygon points="498,270 510,263 522,270 522,282 510,289 498,282" fill="rgba(255,170,0,.3)" stroke="rgba(255,170,0,.65)" stroke-width="1" style="animation:nodePulse 2s ease-in-out infinite 1.5s"/>
    </svg>

    <div class="avatar-clip" id="av">
      <img src="data:image/png;base64," alt="Jarvis"/>
    </div>
    <div class="arc"></div>
    <div class="title-wrap">
      <h1>J · A · R · V · I · S</h1>
      <div class="sub">Team Iron Solutions &nbsp;·&nbsp; AI Division &nbsp;·&nbsp; v2026.7.1</div>
    </div>
    <div class="status-row"><div class="sdot"></div><div class="stxt" id="stxt">STANDBY</div></div>
    <div class="waveform" id="wf"></div>

  <!-- Chat Panel -->
  <div class="chat-panel" id="chat-panel">
    <div class="chat-messages" id="chat-messages"></div>
  </div>

  <!-- Input Panel -->
  <div style="position:fixed;bottom:50px;left:50%;transform:translateX(-50%);width:min(80vw,800px);z-index:14;display:flex;gap:6px;align-items:center;pointer-events:all">
    <input 
      id="msg-input" 
      type="text" 
      placeholder="Fale com Jarvis..." 
      autocomplete="off"
      style="flex:1;padding:8px 12px;border:1px solid rgba(0,212,255,.3);background:rgba(0,8,25,.9);color:#00d4ff;border-radius:6px;font-family:'Rajdhani',sans-serif;font-size:12px;outline:none;transition:border-color .2s"
      onkeydown="if(event.key==='Enter')sendMsg()"
      onfocus="this.style.borderColor='rgba(0,212,255,.7)'"
      onblur="this.style.borderColor='rgba(0,212,255,.3)'"
    />
    <button 
      onclick="sendMsg()"
      style="padding:8px 16px;border:1px solid rgba(0,212,255,.4);background:rgba(0,212,255,.08);color:#00d4ff;border-radius:6px;cursor:pointer;font-family:'Rajdhani',sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;transition:all .2s;font-weight:600"
      onmouseover="this.style.background='rgba(0,212,255,.15)';this.style.borderColor='rgba(0,212,255,.7)'"
      onmouseout="this.style.background='rgba(0,212,255,.08)';this.style.borderColor='rgba(0,212,255,.4)'"
    >Enviar</button>
  </div>

    <div class="panel left">
      <div class="dblock"><div class="dlabel">Sistema</div><div class="dval green">ONLINE</div><div class="dbar"><div class="dbar-fill" style="width:99%"></div></div></div>
      <div class="dblock"><div class="dlabel">Uptime SLA</div><div class="dval">99.98%</div><div class="dbar"><div class="dbar-fill" style="animation-duration:4s"></div></div></div>
      <div class="dblock"><div class="dlabel">Integrações</div><div class="dval gold">42</div><div class="dbar"><div class="dbar-fill" style="width:70%;animation-duration:5s"></div></div></div>
      <div class="dblock"><div class="dlabel">CPU</div><div class="dval" id="cpu">64%</div><div class="dbar"><div class="dbar-fill" id="cpubar" style="width:64%"></div></div></div>
    </div>

    <div class="panel right">
      <div class="dblock"><div class="dlabel">Modelo IA</div><div class="dval" style="font-size:12px">CLAUDE·S4</div></div>
      <div class="dblock"><div class="dlabel">Voz</div><div class="dval gold">DANIEL</div></div>
      <div class="dblock"><div class="dlabel">Gateway</div><div class="dval green" style="font-size:12px">LOCAL</div><div class="dbar"><div class="dbar-fill" style="width:96%"></div></div></div>
      <div class="dblock"><div class="dlabel">Deploys/mês</div><div class="dval">120</div><div class="dbar"><div class="dbar-fill" style="width:60%"></div></div></div>
    </div>
  </div>
</div>

<div class="bot">
  <span class="tis-logo">TIS // IRON DIVISION</span>
  <div class="ticker-wrap"><div class="ticker">JARVIS ONLINE &nbsp;·&nbsp; GATEWAY ATIVO &nbsp;·&nbsp; CLAUDE-SONNET-4-6 &nbsp;·&nbsp; UPTIME 99.98% &nbsp;·&nbsp; SQUAD EM CONSTRUÇÃO &nbsp;·&nbsp; TEAM IRON SOLUTIONS &nbsp;·&nbsp; TRANSFORMAMOS TECNOLOGIA EM VANTAGEM COMPETITIVA &nbsp;·&nbsp;</div></div>
  <span id="clk">--:--:--</span>
</div>

<script>
const cv=document.getElementById('bg'),cx=cv.getContext('2d');
let W,H;const rsz=()=>{W=cv.width=innerWidth;H=cv.height=innerHeight};rsz();addEventListener('resize',rsz);
class P{constructor(){this.r()}r(){this.x=Math.random()*W;this.y=Math.random()*H;this.vx=(Math.random()-.5)*.35;this.vy=(Math.random()-.5)*.35;this.rad=Math.random()*.9+.2;this.a=Math.random()*.22+.05;this.life=Math.random()*400+200;this.age=0}u(){this.x+=this.vx;this.y+=this.vy;this.age++;if(this.age>this.life)this.r()}d(){const f=Math.sin(this.age/this.life*Math.PI);cx.globalAlpha=this.a*f;cx.fillStyle=Math.random()<.08?'#ffaa00':'#00d4ff';cx.beginPath();cx.arc(this.x,this.y,this.rad,0,Math.PI*2);cx.fill()}}
const pts=Array.from({length:130},()=>new P());
const fr=()=>{cx.clearRect(0,0,W,H);pts.forEach(p=>{p.u();p.d()});requestAnimationFrame(fr)};fr();
const wf=document.getElementById('wf');
for(let i=0;i<40;i++){const b=document.createElement('div');b.className='wb';b.style.height=(Math.random()*30+8)+'px';b.style.animationDuration=(Math.random()*.7+.35)+'s';b.style.animationDelay=(Math.random()*.4)+'s';wf.appendChild(b);}
const pad=n=>String(n).padStart(2,'0');
const tick=()=>{const d=new Date();document.getElementById('clk').textContent=pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds())};tick();setInterval(tick,1000);
setInterval(()=>{const v=Math.round(50+Math.random()*30);document.getElementById('cpu').textContent=v+'%';document.getElementById('cpubar').style.width=v+'%'},3500);
let spk=false;
document.getElementById('av').addEventListener('click',()=>{spk=!spk;applySpk(spk,false);});

// ── Bridge Polling ────────────────────────────────────────────────────────────
const BRIDGE='http://127.0.0.1:3033';
const GATEWAY='http://localhost:18789';

// ── Send Message ──────────────────────────────────────────────────────────────
async function sendMsg(){
  const input=document.getElementById('msg-input');
  const msg=input.value.trim();
  if(!msg)return;

  // Otimista: adiciona mensagem no chat imediatamente
  addChatMsg('user', msg);
  input.value='';
  input.disabled=true;

  try{
    const res=await fetch(BRIDGE+'/send',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({message:msg}),
      signal:AbortSignal.timeout(5000)
    });
    const data=await res.json();
    if(!data.ok) throw new Error(data.error||'bridge error');
    // Sinaliza processando enquanto aguarda resposta
    document.body.classList.add('processing');
    document.querySelector('.stxt').textContent='PROCESSING';
    setTimeout(()=>{
      document.body.classList.remove('processing');
      const stxt=document.querySelector('.stxt');
      if(stxt&&stxt.textContent==='PROCESSING')stxt.textContent='ONLINE';
    },8000);
  }catch(e){
    console.error('[HUD send error]',e);
    // fallback visual
    const stxt=document.querySelector('.stxt');
    if(stxt){stxt.textContent='ERRO BRIDGE';setTimeout(()=>stxt.textContent='ONLINE',3000);}
  }finally{
    input.disabled=false;
    input.focus();
  }
}

async function generateAndPlayTTS(text){
  try{
    // Esta é uma demonstração. Na prática, o OpenClaw faria isso automaticamente
    // via /messages.tts.auto = 'always'
    console.log('[TTS] Gerando áudio para:',text);
    
    // Simular TTS (em produção, o gateway faria isso)
    // Por enquanto, apenas log que o TTS seria acionado
  }catch(e){
    console.error('[TTS Error]',e);
  }
}

function addChatMsg(role,text){
  const container=document.getElementById('chat-messages');
  const div=document.createElement('div');
  div.className='chat-msg '+role;
  const label=role==='user'?'GALVÃO':'JARVIS';
  let txt=text.replace(/</g,'&lt;').replace(/>/g,'&gt;');
  if(txt.length>160)txt=txt.slice(0,160)+'…';
  div.innerHTML=`<span class="chat-label">${label}</span><div class="bubble">${txt}</div>`;
  container.appendChild(div);
  container.parentElement.scrollTop=container.parentElement.scrollHeight;
}
let lastMsgSig='';
let lastSpk=false;
let lastStatus='';

function applySpk(speaking,processing){
  spk=speaking;
  document.body.classList.toggle('speaking',speaking);
  document.body.classList.toggle('processing',processing&&!speaking);
  const st=speaking?'SPEAKING':processing?'PROCESSING':'STANDBY';
  if(document.getElementById('stxt').textContent!==st){
    document.getElementById('stxt').textContent=st;
  }
  document.querySelectorAll('.wb').forEach(b=>{
    if(speaking){b.style.animationDuration=(Math.random()*.12+.1)+'s';}
    else if(processing){b.style.animationDuration=(Math.random()*.3+.2)+'s';}
    else{b.style.animationDuration=(Math.random()*.7+.35)+'s';}
  });
}

function renderChat(messages){
  const container=document.getElementById('chat-messages');
  if(!messages||!messages.length)return;
  const sig=messages.map(m=>m.timestamp).join(',');
  if(sig===lastMsgSig)return;
  lastMsgSig=sig;
  container.innerHTML='';
  messages.slice(-3).forEach(msg=>{
    const div=document.createElement('div');
    div.className='chat-msg '+msg.role;
    const label=msg.role==='user'?'GALVÃO':'JARVIS';
    let txt=msg.text||'';
    txt=txt.replace(/</g,'&lt;').replace(/>/g,'&gt;');
    if(txt.length>160)txt=txt.slice(0,160)+'…';
    div.innerHTML=`<span class="chat-label">${label}</span><div class="bubble">${txt}</div>`;
    container.appendChild(div);
  });
}

// ── WebSocket Connection ──────────────────────────────────────────────
let ws = null;
let wsReconnectCount = 0;
const MAX_RECONNECT = 5;

function connectWS() {
  if (ws && (ws.readyState === 0 || ws.readyState === 1)) return;
  
  try {
    ws = new WebSocket('ws://127.0.0.1:3033/ws');
    
    ws.onopen = () => {
      console.log('🔌 Bridge WS connected');
      wsReconnectCount = 0;
    };
    
    ws.onmessage = (evt) => {
      try {
        const msg = JSON.parse(evt.data);
        handleBridgeEvent(msg);
      } catch (e) {
        console.error('WS parse error:', e);
      }
    };
    
    ws.onerror = (err) => {
      console.warn('🔌 Bridge WS error:', err);
    };
    
    ws.onclose = () => {
      console.log('🔌 Bridge WS disconnected');
      wsReconnectCount++;
      if (wsReconnectCount < MAX_RECONNECT) {
        setTimeout(connectWS, 2000 + wsReconnectCount * 1000);
      }
    };
  } catch (e) {
    console.warn('WS connection failed:', e);
  }
}

function handleBridgeEvent(msg) {
  if (!msg.type) return;
  
  // State update
  if (msg.type === 'state') {
    if (msg.speaking !== lastSpk || msg.status !== lastStatus) {
      lastSpk = msg.speaking;
      lastStatus = msg.status;
      applySpk(msg.speaking, msg.processing);
    }
    if (msg.messages) renderChat(msg.messages);
    
    // Show transcript if available
    if (msg.transcript) showTranscript(msg.transcript);
  }
  
  // Status change (LISTENING, PROCESSING, SPEAKING, STANDBY)
  if (msg.type === 'status-change') {
    lastStatus = msg.status;
    const speaking = msg.status === 'SPEAKING';
    const processing = msg.status === 'PROCESSING' || msg.status === 'LISTENING';
    applySpk(speaking, processing);
  }
  
  // Real-time transcript
  if (msg.type === 'transcript') {
    showTranscript(msg.text);
    if (msg.final) {
      // Clear transcript after final
      setTimeout(() => clearTranscript(), 800);
    }
  }
}

function showTranscript(text) {
  const container = document.getElementById('chat-messages');
  if (!container) return;
  
  let transcriptDiv = document.getElementById('live-transcript');
  if (!transcriptDiv) {
    transcriptDiv = document.createElement('div');
    transcriptDiv.id = 'live-transcript';
    transcriptDiv.className = 'chat-msg user';
    transcriptDiv.style.opacity = '0.7';
    transcriptDiv.innerHTML = `
      <span class="chat-label">GALVÃO</span>
      <div class="bubble" style="font-style: italic; opacity: 0.8;"></div>
    `;
    container.appendChild(transcriptDiv);
  }
  
  const bubble = transcriptDiv.querySelector('.bubble');
  if (bubble) {
    bubble.textContent = text.slice(0, 160) + (text.length > 160 ? '…' : '');
  }
}

function clearTranscript() {
  const transcriptDiv = document.getElementById('live-transcript');
  if (transcriptDiv) {
    transcriptDiv.remove();
  }
}

// ── HTTP Polling Fallback ──────────────────────────────────────────
async function pollBridge(){
  try{
    const r=await fetch(BRIDGE+'/state',{signal:AbortSignal.timeout(900)});
    if(!r.ok)return;
    const data=await r.json();
    if(data.speaking!==lastSpk||data.status!==lastStatus){
      lastSpk=data.speaking;
      lastStatus=data.status;
      applySpk(data.speaking,data.processing);
    }
    if(data.messages)renderChat(data.messages);
  }catch(e){/* bridge offline — ok */}
}

// Connect WebSocket and start polling
connectWS();
setInterval(pollBridge,1800);
pollBridge();
</script>
</body>
</html>