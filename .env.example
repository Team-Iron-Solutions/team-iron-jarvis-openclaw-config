# Graphify Phase 4 — Configuration Template
# Copy to .env.local and fill in your values

# Ollama API Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Graphify Output Directories
GRAPHIFY_OUTPUT_DIR=./graphify-out
GRAPHIFY_CACHE_DIR=./.cache/graphify

# Performance Tuning
GRAPHIFY_MAX_WORKERS=4
GRAPHIFY_TIMEOUT_SECONDS=300

# Logging
GRAPHIFY_LOG_LEVEL=INFO

# Optional: Custom model sizes (alternatives to qwen3.5:4b)
# OLLAMA_MODEL=qwen3.5:2b  # Fastest (2.7GB, ~5sec per file)
# OLLAMA_MODEL=qwen3.5:9b  # Best quality (6.6GB, ~30sec per file)
# OLLAMA_MODEL=llama3.2:3b # Alternative (2.0GB)
