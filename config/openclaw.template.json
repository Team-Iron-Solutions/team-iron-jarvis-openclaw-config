        "description": "Backend Python",
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": ["openrouter/anthropic/claude-haiku-4-5", "openrouter/auto"]
        }
      },
      {
        "id": "steve-rogers",
        "name": "Steve Rogers",
        "description": "Software Architect",
        "model": {
          "primary": "anthropic/claude-sonnet-4-6",
          "fallbacks": ["openrouter/anthropic/claude-sonnet-4-6"]
        }
      },
      {
        "id": "stephen-strange",
        "name": "Stephen Strange",
        "description": "Product Manager",
        "model": {
          "primary": "anthropic/claude-sonnet-4-6",
          "fallbacks": ["openrouter/anthropic/claude-sonnet-4-6"]
        }
      },
      {
        "id": "visao",
        "name": "Visão",
        "description": "Data Engineer / IA",
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": ["openrouter/anthropic/claude-haiku-4-5", "openrouter/auto"]
        }
      },
      {
        "id": "wanda-maximoff",
        "name": "Wanda Maximoff",
        "description": "Product Designer / UX",
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": ["openrouter/anthropic/claude-haiku-4-5", "openrouter/auto"]
        }
      },
      {
        "id": "tchalla",
        "name": "T'Challa",
        "description": "SRE Engineer",
