{
  "meta": {
    "version": "2026.8.30",
    "description": "Team Iron Solutions - OpenClaw Configuration Template",
    "notes": "Copy to ~/.openclaw/openclaw.json. Replace all ${...} placeholders with real values."
  },
  "env": {
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
  },
  "agents": {
    "defaults": {
      "thinking": "medium",
      "model": {
        "primary": "anthropic/claude-haiku-4-5",
        "fallbacks": [
          "openrouter/anthropic/claude-haiku-4-5",
          "openrouter/auto",
          "google/gemini-3.1-pro-preview"
        ]
      },
      "skills": {
        "allowBundled": ["gemini", "peekaboo"],
        "load": {
          "extraDirs": ["./workspace/skills"]
        }
      }
    },
    "list": [
      {
        "id": "main",
        "name": "Jarvis - CTO",
        "description": "Tech Lead & Architecture",
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": ["openrouter/anthropic/claude-haiku-4-5", "openrouter/auto"]
        }
      },
      {
        "id": "tony-stark",
        "name": "Tony Stark",
        "description": "Backend Node.js + Tech Lead",
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": ["openrouter/anthropic/claude-haiku-4-5", "openrouter/auto"]
        }
      },
      {
        "id": "bruce-banner",
