{
  "meta": {
    "version": "2026.09.05",
    "description": "Team Iron Solutions - OpenClaw Configuration Template",
    "notes": "Copy to ~/.openclaw/openclaw.json. Replace all ${...} placeholders with real values.",
    "changelog": [
      "2026-09-05: Multi-agent model routing (Haiku primário 200k ctx, Qwen fallback)",
      "2026-09-05: Heartbeat desabilitado em 10 agentes de trabalho (apenas main ativo)",
      "2026-09-05: Critical Task Reminder → 3x/dia + isolated session",
      "2026-09-05: Telegram canal configurado",
      "2026-09-05: Providers Anthropic e Google registrados (fix Unknown model)",
      "2026-09-06: Thresholds Tony/Bruce ajustados para -40% (Phase 5B Go/No-Go)"
    ]
  },
  "models": {
    "providers": {
      "anthropic": {
        "models": [
          {
            "id": "claude-haiku-4-5",
            "name": "claude-haiku-4-5"
          },
          {
            "id": "claude-sonnet-4-6",
            "name": "claude-sonnet-4-6"
          },
          {
            "id": "claude-sonnet-5",
            "name": "claude-sonnet-5"
          }
        ]
      },
      "google": {
        "models": [
          {
            "id": "gemini-3.1-pro-preview",
            "name": "gemini-3.1-pro-preview"
          }
        ]
      },
      "openrouter": {
        "params": {
          "provider": {
            "sort": "price",
            "data_collection": "deny"
          }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5",
        "fallbacks": [
          "openrouter/anthropic/claude-haiku-4-5",
          "openrouter/auto",
          "google/gemini-3.1-pro-preview"
        ]
      },
      "modelPolicy": {
        "allow": [
          "anthropic/claude-haiku-4-5",
          "anthropic/claude-sonnet-4-6",
          "google/gemini-3.1-pro-preview",
          "openrouter/deepseek/deepseek-r1",
          "openrouter/deepseek/deepseek-v3",
          "openrouter/qwen/qwen-2.5-coder-32b-instruct",
          "openrouter/auto",
          "openrouter/anthropic/claude-haiku-4-5",
          "openrouter/google/gemini-2.5-pro"
        ]
      },
      "heartbeat": {
        "every": "30m",
        "lightContext": true,
        "isolatedSession": true
      },
      "models": {
        "anthropic/claude-sonnet-4-6": {
          "alias": "sonnet"
        },
        "google/gemini-3.1-pro-preview": {
          "alias": "gemini"
        },
        "anthropic/claude-haiku-4-5": {
          "alias": "haiku"
        }
      },
      "systemAgent": {
        "agentId": "main"
      }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/anthropic/claude-haiku-4-5",
            "openrouter/auto",
            "google/gemini-3.1-pro-preview"
          ]
        },
        "heartbeat": {
          "every": "30m",
          "lightContext": true,
          "isolatedSession": true
        }
      },
      "tony": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/qwen/qwen-2.5-coder-32b-instruct",
            "openrouter/deepseek/deepseek-v3",
            "openrouter/auto"
          ]
        }
      },
      "bruce": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/qwen/qwen-2.5-coder-32b-instruct",
            "openrouter/deepseek/deepseek-v3",
            "openrouter/auto"
          ]
        }
      },
      "steve": {
        "model": {
          "primary": "anthropic/claude-sonnet-4-6",
          "fallbacks": [
            "openrouter/deepseek/deepseek-r1",
            "openrouter/auto"
          ]
        }
      },
      "stephen": {
        "model": {
          "primary": "openrouter/deepseek/deepseek-r1",
          "fallbacks": [
            "anthropic/claude-sonnet-4-6",
            "openrouter/auto"
          ]
        }
      },
      "scott": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/qwen/qwen-2.5-coder-32b-instruct",
            "openrouter/deepseek/deepseek-v3",
            "openrouter/auto"
          ]
        }
      },
      "natasha": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/qwen/qwen-2.5-coder-32b-instruct",
            "openrouter/deepseek/deepseek-v3",
            "openrouter/auto"
          ]
        }
      },
      "tchalla": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/qwen/qwen-2.5-coder-32b-instruct",
            "openrouter/deepseek/deepseek-v3",
            "openrouter/auto"
          ]
        }
      },
      "visao": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/qwen/qwen-2.5-coder-32b-instruct",
            "openrouter/deepseek/deepseek-v3",
            "openrouter/auto"
          ]
        }
      },
      "wanda": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/auto",
            "google/gemini-3.1-pro-preview"
          ]
        }
      },
      "peter": {
        "model": {
          "primary": "anthropic/claude-haiku-4-5",
          "fallbacks": [
            "openrouter/auto",
            "google/gemini-3.1-pro-preview"
          ]
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "mcp": {
    "servers": {
      "filesystem": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/Users/teamironsolutions/.openclaw/workspace"
        ],
        "toolFilter": {
          "include": [
            "read_file",
            "list_directory",
            "write_file",
            "search_files",
            "create_directory",
            "move_file",
            "delete_file"
          ]
        }
      },
      "memory": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-memory"
        ]
      },
      "github": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_TOKEN": "${GITHUB_TOKEN}"
        }
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "accounts": {
        "default": {
          "enabled": true
        }
      }
    },
    "telegram": {
      "enabled": true,
      "tokenFile": "~/.openclaw/telegram.token",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${TELEGRAM_CHAT_ID}"
      ],
      "notes": "Criar bot via @BotFather, salvar token em ~/.openclaw/telegram.token, configurar Chat ID"
    }
  },
  "messages": {},
