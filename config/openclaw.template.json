          "fallbacks": ["openrouter/anthropic/claude-haiku-4-5", "openrouter/auto"]
        }
      }
    ]
  },
  "models": {
    "providers": {
      "openrouter": {
        "params": {
          "provider": {
            "sort": "price",
            "data_collection": "deny"
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "memory": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-memory"]
      },
      "filesystem": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "./workspace"],
        "toolFilter": {
          "include": [
            "read_file",
            "list_directory",
            "write_file",
            "search_files",
            "create_directory",
            "move_file",
            "delete_file"
          ]
        }
      },
      "github": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": {
          "GITHUB_TOKEN": "${GITHUB_TOKEN}"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "commands": {
    "ownerAllowFrom": ["webchat:owner"]
  },
  "messages": {
    "tts": {
      "enabled": true,
      "voice": {
        "service": "elevenlabs",
        "voiceId": "${ELEVENLABS_VOICE_ID}",
        "model": "eleven_turbo_v2_5"
      }
    }
  },
  "skills": {
    "workshop": {
      "approvalPolicy": "pending",
      "maxPending": 50,
      "maxSkillBytes": 40000
    }
  }
}
